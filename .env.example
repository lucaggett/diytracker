# Copy to .env and fill in. See README "Environment" for details.
# Variables in the first block are read by Config.from_env() in
# diytracker/config.py; the rest are read directly from the environment
# where noted.

# REQUIRED. Flask session signing key. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-any-long-random-string

# SQLAlchemy database URI. Relative sqlite paths resolve against instance/.
#DATABASE_URI=sqlite:///events.db

# Only required to accept pushes on POST /api/ingest (see README "Ingest").
# Unset = endpoint disabled. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match the INGEST_TOKEN used by pushers (e.g. the eventbot forwarder).
#INGEST_TOKEN=

# Canonical origin for <link rel="canonical">, og:url and JSON-LD URLs.
# Unset = fall back to the request host (fine for dev); production must set
# it so canonicals don't depend on request headers.
#CANONICAL_HOST=https://diytracker.ch

# Only required if you want the contact form / user invites to send mail
# (read directly by diytracker/services/contact.py and manage.py).
#EMAIL_SERVER=smtp.example.com
#EMAIL_USERNAME=
#EMAIL_PASSWORD=

# Optional: where analytics reads nginx logs from (read by services/analytics.py)
#NGINX_LOG_PATTERN=access.log

# Do NOT set ENABLE_SCRAPER here: under gunicorn the post_fork hook enables
# the scrape scheduler for exactly one worker. For the dev server, run
#   ENABLE_SCRAPER=1 uv run python app.py
