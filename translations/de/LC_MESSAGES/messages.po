#: templates/accessibility_form.html:4 templates/venue_accessibility.html:3
msgid "Accessibility"
msgstr "Barrierefreiheit"

#: templates/accessibility_form.html:10 templates/venue_accessibility.html:47
msgid "Accessibility information"
msgstr "Informationen zur Barrierefreiheit"

#: templates/accessibility_form.html:14 templates/venue_accessibility.html:62
msgid "Last updated"
msgstr "Zuletzt aktualisiert"

#: templates/accessibility_form.html:18
msgid ""
"Please fill in as much as you know. Leave fields blank if you are unsure "
"— partial information is still helpful."
msgstr ""
"Fülle so viel aus, wie du weisst. Lass Felder leer, wenn du unsicher bist"
" — auch teilweise Angaben sind hilfreich."

#: templates/accessibility_form.html:26 templates/venue_accessibility.html:70
msgid "Mobility & Wheelchair"
msgstr "Mobilität & Rollstuhl"

#: templates/accessibility_form.html:29
msgid "e.g. ramp at side entrance, ask staff"
msgstr "z.B. Rampe am Seiteneingang, beim Personal nachfragen"

#: templates/accessibility_form.html:32
msgid "e.g. located near main bar, key required from staff"
msgstr "z.B. neben der Hauptbar, Schlüssel beim Personal erhältlich"

#: templates/accessibility_form.html:46 templates/venue_accessibility.html:92
msgid "Sensory, Epilepsy & Autism"
msgstr "Sensorik, Epilepsie & Autismus"

#: templates/accessibility_form.html:49
msgid "Is a verbal or visual warning given before strobes are used?"
msgstr ""
"Gibt es eine mündliche oder visuelle Vorwarnung vor dem Einsatz von "
"Stroboskoplicht?"

#: templates/accessibility_form.html:52
msgid "A calm room away from the main space where people can decompress"
msgstr "Ein ruhiger Raum abseits des Hauptbereichs, wo man sich erholen kann"

#: templates/accessibility_form.html:54
msgid "Events with reduced lights, lower volume, and a relaxed atmosphere"
msgstr ""
"Veranstaltungen mit gedämpftem Licht, niedrigerer Lautstärke und "
"entspannter Atmosphäre"

#: templates/accessibility_form.html:57 templates/venue_accessibility.html:104
msgid "Hearing"
msgstr "Hören"

#: templates/accessibility_form.html:59
msgid "An induction loop that transmits sound directly to hearing aids"
msgstr "Eine Induktionsschleife, die den Ton direkt an Hörgeräte überträgt"

#: templates/accessibility_form.html:63 templates/venue_accessibility.html:111
msgid "Medical"
msgstr "Medizinisches"

#: templates/accessibility_form.html:65
msgid "For insulin, EpiPens, or other temperature-sensitive medication"
msgstr "Für Insulin, EpiPens oder andere temperatursensible Medikamente"

#: templates/accessibility_form.html:67
msgid "Automated External Defibrillator"
msgstr "Automatischer Externer Defibrillator"

#: templates/accessibility_form.html:70 templates/venue_accessibility.html:124
msgid "General & Social"
msgstr "Allgemein & Soziales"

#: templates/accessibility_form.html:73
msgid "e.g. 50 m to tram stop, level access from platform"
msgstr "z.B. 50 m zur Tramhaltestelle, ebener Zugang vom Bahnsteig"

#: templates/accessibility_form.html:75
msgid "Seating available for people who cannot stand for long periods"
msgstr "Sitzgelegenheiten für Personen, die nicht lange stehen können"

#: templates/accessibility_form.html:77
msgid "An alternative entrance that avoids crowded queues or loud lobby areas"
msgstr ""
"Ein alternativer Eingang, der überfüllte Warteschlangen oder laute "
"Eingangsbereiche umgeht"

#: templates/accessibility_form.html:78
msgid "Anything else visitors with disabilities should know"
msgstr "Alles Weitere, das Besuchende mit Behinderungen wissen sollten"

#: templates/accessibility_form.html:80
